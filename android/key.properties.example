# Copy to android/key.properties and fill in. NEVER commit key.properties.
# Create the keystore first (keep the .jks file safe & backed up):
#   keytool -genkey -v -keystore ~/claimr-upload.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias upload
storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=/Users/YOU/claimr-upload.jks
