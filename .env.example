# Copy this file to `.env` and fill in your real tokens. Never commit `.env`.

# Mapbox PUBLIC access token (starts with "pk."). Used at runtime to load maps.
# Get it from https://account.mapbox.com/access-tokens/
MAPBOX_PUBLIC_TOKEN=pk.your_public_token_here

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase PUBLISHABLE key (starts "sb_publishable_") — or the legacy "anon" JWT.
# Project Settings -> API in your Supabase dashboard.
SUPABASE_PUBLISHABLE_KEY=
